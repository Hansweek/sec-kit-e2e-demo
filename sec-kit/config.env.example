# ============================================================================
#  govee-sec-kit 客户差异配置模板 (config.env.example) · v2
# ----------------------------------------------------------------------------
#  用法: 复制为 config.env 后逐项填写。这是"换客户唯一要改的文件"——
#        bin/ 下核心脚本零修改，ci/ 下薄封装只负责把变量注入执行环境。
#  ⚠ 给客户交付示例时: 本文件就是接入方要填的清单——
#        【必填】只有 6 项(标 ▲)；其余全部有安全默认值，按需覆盖。
#  安全: 令牌只放这里或 CI 凭据管理(CI Variables/Secrets，勾 Masked)，
#        config.env 加入 .gitignore 严禁提交仓库。本文件永不包含真实凭据。
#  加载: 本地/联调  → source config.env 后手动执行脚本
#        CI 流水线  → 建议直接配到 CI 变量里，本文件仅作变量清单与命名对照
# ============================================================================

# ---------------- 灵脉CodeAI（SAST 源码检测）----------------
SAST_URL=https://codeai.customer.local      # ▲ 平台地址，结尾不带 /
SAST_TOKEN=                                  # ▲ 平台右上角头像→个人中心→访问令牌
SAST_USERNAME=                               # ▲ 令牌归属人平台用户名 → 自动设为项目经理+归属其部门(项目自动纳管v2)
SAST_PROJECT_ID=0                            # 项目管理ID；0=按名称自动解析/创建(推荐)
SAST_PROJECT_NAME=                           # 项目名；留空=仓库名(推荐，一仓一项目)
SAST_PROJECT_AUTO_CREATE=1                   # 1=平台无同名项目自动创建(默认) 0=只查找
SAST_PROJECT_MEMBERS=                        # 项目成员(平台用户名逗号分隔)；GitHub 封装自动拉协作人注入，云效/手动场景在此维护
SAST_REPORT_KIND=DEFECT                      # DEFECT=详情报告(默认) ANALYSE=概要
EXPORT_DEFECTS=1                             # 1=归档全缺陷+全跟踪路径(JSON+HTML, 默认)

# ---------------- 源鉴SCA（开源组件检测）----------------
SCA_URL=https://sca.customer.local:30001     # ▲ 平台地址，结尾不带 /，必须带 :30001 端口
SCA_USER_TOKEN=                              # ▲ 个人中心→访问令牌（provision/扫描/报告通用）
SCA_USERNAME=                                # 令牌归属人用户名；留空继承 SAST_USERNAME(两平台同名时配一个即可)
SCA_PROJECT_NAME=                            # 留空=仓库名；SCA provision 按此名自动建/复用项目(v2带归属)
SCA_PROJECT_SYNC_MEMBERS=0                   # 1=项目已存在时也尝试同步成员/负责人(project/edit, 幂等)
SCAN_PATTERNS=                               # 制品扫描模式(嵌入式/固件样本用)，如 '.*\.(bin|hex|img|tar\.gz)$'
AUTO_SBOM=1                                  # 1=依赖扫描完成后自动导出 SBOM+VEX 并归档(默认)
SBOM_TYPES="spdx vex"                        # 导出类型: spdx vex(默认) / 可加 cyclonedx

# ---------------- 应用命名规范 ---------------------------------------------
# 默认自动取 <仓库名>-<分支名>（同分支自动复用应用并延续增量基线）
# 需要固定应用名时取消注释，注意：后端与嵌入式建议前缀区分
# APP_NAME=govee-backend-main

# ---------------- 质量门禁（灰度期全 0=只告警；稳定后 ENABLE=1 启用阻断）----
# ⚠ CodeAI 门禁缺省=0(告警) 但 SCA 红线缺省=1(阻断)：DEPS_GATE/ARTIFACT_GATE
#   必须在 CI 里显式配 0，否则平台配了组件基线/黑白名单时灰度期直接置红
GATE_ENABLED=0                               # CodeAI 门禁总开关
GATE_SUPER=0                                 # 超危阈值
GATE_HIGH=0                                  # 高危阈值
GATE_MIDDLE=0                                # 中危阈值
GATE_LOW=0                                   # 低危阈值（99999=不卡低危）
DEPS_GATE=0                                  # SCA 依赖扫描红线
ARTIFACT_GATE=0                              # SCA 制品扫描红线

# ---------------- 超时与放行策略 --------------------------------------------
BY_PASS=1                                    # 1=平台排队超时放行不卡流水线；0=严格模式
BY_PASS_TIMEOUT_MINUTES=60                   # CodeAI 共享引擎排队+扫描超时，建议≥60
TIMEOUT_MINUTES=60                           # SCA 超时分钟数
HARD_TIMEOUT_MINUTES=180                     # CodeAI 绝对硬上限(BY_PASS=0 时防死等)

# ---------------- 钉钉/企微/飞书 聚合通知（sec-notify.sh，流水线末步）------
# 设计: SAST+SCA+SBOM 聚合成一张卡片推送；钉钉机器人安全模式 加签/关键词 均支持
NOTIFY_WEBHOOK=                              # ▲(推荐) 群机器人 Webhook，如 https://oapi.dingtalk.com/robot/send?access_token=xxx
NOTIFY_TYPE=dingtalk                         # dingtalk | wecom | feishu
NOTIFY_SECRET=                               # 钉钉"加签"密钥(加签模式必填；关键词模式留空)
NOTIFY_AT=                                   # 需@的手机号，逗号分隔；默认仅门禁阻断时@ (NOTIFY_AT_ON_FAIL=1)
NOTIFY_AT_ON_FAIL=1                          # 1=仅阻断时@(默认, 减少打扰) 0=总是@
NOTIFY_TOP_N=3                               # 卡片展示 TOP 高危缺陷条数(0=不展示)

# ---------------- 通用 ------------------------------------------------------
TLS_INSECURE=1                               # 1=跳过TLS证书校验(自签证书)；平台配受信证书后改0
RESULT_DIR=./sec-results                     # 结果目录(报告/SBOM/VEX/缺陷导出统一归档处)
TASK_SOURCE_TYPE=3009                        # CodeAI 任务来源标签: 3001=Jenkins 3004=GitLab-CI 3009=通用Shell

# ============================================================================
# 【CI 平台变量命名对照】
# ----------------------------------------------------------------------------
# ▶ GitHub Actions (ci/github-actions/security-scan.yml)
#   配置位置: 仓库/组织 → Settings → Secrets and variables → Actions
#   非敏感 → Variables ｜ 敏感(令牌/webhook) → Secrets(Masked)
#
#   本文件变量名           → GitHub Variables(非敏感) / Secrets(敏感)
#   SAST_URL              → vars.CODEAI_URL
#   SAST_TOKEN            → secrets.CODEAI_TOKEN
#   SAST_USERNAME         → vars.SAST_USERNAME
#   SAST_PROJECT_ID       → vars.CODEAI_PROJECT_ID
#   SAST_PROJECT_NAME     → vars.CODEAI_PROJECT_NAME (缺省自动=仓库名,无需配)
#   GATE_SUPER/HIGH/...   → vars.CODEAI_GATE_SUPER / CODEAI_GATE_HIGH / ...
#   BY_PASS_TIMEOUT_MINUTES→ vars.CODEAI_TIMEOUT_MINUTES
#   SCA_URL               → vars.SCA_URL
#   SCA_USER_TOKEN        → secrets.SCA_USER_TOKEN
#   SCA_USERNAME          → vars.SCA_USERNAME (缺省继承 SAST_USERNAME)
#   TIMEOUT_MINUTES       → vars.SCA_TIMEOUT_MINUTES
#   SBOM_TYPES            → vars.SBOM_TYPES (缺省 "spdx vex")
#   NOTIFY_WEBHOOK        → secrets.NOTIFY_WEBHOOK (兼容旧名 secrets.DINGTALK_WEBHOOK)
#   NOTIFY_SECRET         → secrets.NOTIFY_SECRET (兼容旧名 secrets.DINGTALK_SECRET)
#   NOTIFY_AT             → vars.DINGTALK_AT
#   TLS_INSECURE          → vars.TLS_INSECURE
#   SCAN_PATTERNS         → vars.SCAN_PATTERNS(嵌入式仓库)
#   制品扫描开关/目录      → vars.ENABLE_SCA_ARTIFACT=1 / vars.SCA_ARTIFACT_DIR
#   扫描执行开关           → vars.ENABLE_SAST=0 关SAST / vars.ENABLE_SCA=0 关SCA (不配=执行)
#   门禁两级模型           → vars.SECURITY_GATE(总开关) + vars.CODEAI_GATE_ENABLED /
#                           vars.SCA_DEPS_GATE / vars.SCA_ARTIFACT_GATE(组件覆盖)
#   协作人拉取兜底(可选)   → secrets.GH_MEMBER_TOKEN(只读PAT) 或 vars.PROJECT_MEMBERS(手工清单)
#
# ▶ 阿里云效 Flow (ci/yunxiao/yunxiao-security-step.sh)
#   配置位置: 流水线 → 变量与缓存(敏感项勾"私密")，变量名与本文件完全一致:
#   SAST_URL / SAST_TOKEN(私密) / SAST_USERNAME / SCA_URL / SCA_USER_TOKEN(私密)
#   NOTIFY_WEBHOOK(私密) / NOTIFY_SECRET(私密) / SECURITY_GATE / SBOM_TYPES / TLS_INSECURE
#   PROJECT_MEMBERS(云效无组织成员API, 手工维护清单) / ENABLE_SCA_ARTIFACT / SCAN_PATTERNS
#   详见 ci/yunxiao/云效Flow接入指南.md
#
# ▶ GitLab-CI / Jenkins: 照云效方式同名注入环境变量即可(核心脚本平台无关)
# ============================================================================
